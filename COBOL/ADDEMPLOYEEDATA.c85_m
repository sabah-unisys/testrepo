082000                                                                              
083000 PROCEDURE DIVISION.                                                          
084000                                                                              
085000 A000.                                                                        
086000     OPEN INPUT INPUT-FILE.                                                   
086250     OPEN UPDATE EMPLOYEEDB                                                   
086500        ON EXCEPTION                                                          
086750            GO TO DMEXCEPT.                                                   
086781                                                                              
086812     FIND LAST EMP-ID-SET                                                     
086843            ON EXCEPTION                                                      
086874            IF DMSTATUS(NOTFOUND)                                             
086905                MOVE 1 TO WS-EMP-ID                                           
086936            ELSE GO TO DMEXCEPT.                                              
086967     MOVE EMP-ID    TO WS-EMP-ID.                                             
087000                                                                              
088000     PERFORM B000 UNTIL WS-NO-MORE-DATA.                                      
089000     CLOSE INPUT-FILE.                                                        
089500     CLOSE EMPLOYEEDB.                                                        
090000 A000-EXIT. EXIT.                                                             
091000                                                                              
092000 B000.                                                                        
092500     ADD 1 TO WS-EMP-ID.                                                      
093000     READ INPUT-FILE                                                          
094000        AT END MOVE "N" TO WS-MORE-DATA-FLAG                                  
094500        GO TO C000-EXIT.                                                      
094583                                                                              
094666     DISPLAY "EMPLOYEE NAME: " FILE-EMP-NAME.                                 
094749     DISPLAY "EMPLOYEE AGE: " FILE-EMP-AGE.                                   
094832     DISPLAY "EMPLOYEE CITY: "FILE-EMP-CITY.                                  
094834     CREATE EMPLOYEE                                                          
094836        ON EXCEPTION                                                          
094838          GO TO DMEXCEPT.                                                     
094840        MOVE WS-EMP-ID TO EMP-ID.                                             
094842        MOVE FILE-EMP-NAME TO EMP-NAME.                                       
094844        MOVE FILE-EMP-AGE TO EMP-AGE.                                         
094846        MOVE FILE-EMP-CITY TO EMP-CITY.                                       
094848                                                                              
094850        BEGIN-TRANSACTION NO-AUDIT RSTART                                     
094852            ON EXCEPTION                                                      
094854             GO TO DMEXCEPT.                                                  
094856        STORE EMPLOYEE                                                        
094858            ON EXCEPTION                                                      
094860            GO TO DMEXCEPT.                                                   
094862        END-TRANSACTION NO-AUDIT RSTART                                       
094864            ON EXCEPTION                                                      
094866            GO TO DMEXCEPT.                                                   
