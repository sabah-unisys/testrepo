044000 DATA DIVISION.                                                               
045000 FILE SECTION.                                                                
045500 FD  INPUT-FILE                                                               
046000     VALUE OF DEPENDENTSPECS IS TRUE.                                         
047000 01 FILE-REC.                                                                 
050000     05                     FILE-EMP-NAME PIC X(10).                          
051000     05                     FILLER      PIC X(1).                             
052000     05                     FILE-EMP-AGE  PIC 9(2).                           
053000     05                     FILLER      PIC X(1).                             
054000     05                     FILE-EMP-CITY PIC X(10).                          
055000                                                                              
062000 DATA-BASE SECTION.                                                           
062250 DB  EMPLOYEEDB.                                                              
062500 01  EMPLOYEE.                                                                
062750 01  RSTART.                                                                  
063000                                                                              
064000 WORKING-STORAGE SECTION.                                                     
064333 01  RESULT                      PIC X(6).                                    
064666 01  MSG                         PIC X(100).                                  
065000                                                                              
066000 01  WS-NO                       PIC X(01) VALUE "N".                         
067000 01  WS-YES                      PIC X(01) VALUE "Y".                         
068000 01  WS-PERIOD                   PIC X(01) VALUE ".".                         
069000                                                                              
070000 01  WS-MORE-DATA-FLAG           PIC X(01) VALUE "Y".                         
